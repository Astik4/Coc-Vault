# Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# ============================================================

# Port the Flask development server listens on
PORT=4000

# JWT signing secret — CHANGE THIS to a long random string in production.
# You can generate one with:  python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars

# Flask debug mode — set to False in production
FLASK_DEBUG=False

# Flask bind host — use 127.0.0.1 (localhost only) for development
# Set to 0.0.0.0 only if you need network access (e.g., inside a container)
FLASK_HOST=127.0.0.1

# Comma-separated list of allowed frontend origins for CORS.
# Add your deployed frontend URL here when going to production.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,null
