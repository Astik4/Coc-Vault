{
    "python.terminal.activateEnvironment": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/Backend/venv/Scripts/python.exe",

    "terminal.integrated.profiles.windows": {
        "PowerShell - CoC Vault": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "& '${workspaceFolder}/Backend/venv/Scripts/Activate.ps1'"
            ]
        }
    },

    "terminal.integrated.defaultProfile.windows": "PowerShell - CoC Vault"
}